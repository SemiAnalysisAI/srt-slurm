+)
+
+// The repair deliberately blocks longer than an HTTP scrape budget. Healthy
+// power must be read again on every scrape, while its watch stays installed.
+func TestProfilingRepairDoesNotBlockFreshPower(t *testing.T) {
+	realDCGM := dcgmprovider.Client()
+	t.Cleanup(func() { dcgmprovider.SetClient(realDCGM) })
+	ctrl := gomock.NewController(t)
+	client := mockdcgm.NewMockDCGM(ctrl)
+	dcgmprovider.SetClient(client)
+	info := testGPUDeviceInfo(ctrl)
+	watcher := mockdevicewatcher.NewMockWatcher(ctrl)
+	profile := testProfilingCounter()
+	power := counters.Counter{FieldID: dcgm.DCGM_FI_DEV_POWER_USAGE, FieldName: "DCGM_FI_DEV_POWER_USAGE", PromType: "gauge"}
+	fields := []dcgm.Short{power.FieldID, profile.FieldID}
+	watch := *devicewatchlistmanager.NewWatchList(info, fields, nil, watcher, 100)
+	var broken, powerReads, powerCleanup atomic.Int32
+	entered, release := make(chan struct{}), make(chan struct{})
+	var releaseOnce, enteredOnce sync.Once
+	unblock := func() { releaseOnce.Do(func() { close(release) }) }
+	defer unblock()
+	watcher.EXPECT().WatchDeviceFieldGroups(gomock.Any(), info).DoAndReturn(
+		func(groups []devicewatcher.FieldWatchGroup, _ deviceinfo.Provider) ([]dcgm.GroupHandle, []dcgm.FieldHandle, []func(), error) {
+			ownsPower := false
+			for _, group := range groups {
+				for _, field := range group.Fields {
+					ownsPower = ownsPower || field == power.FieldID
+				}
+			}
+			if broken.Load() == 1 {
+				enteredOnce.Do(func() { close(entered) })
+				<-release
+				broken.Store(2)
+			}
+			return nil, nil, []func(){func() {
+				if ownsPower {
+					powerCleanup.Add(1)
+				}
+			}}, nil
+		},
+	).AnyTimes()
+	client.EXPECT().EntityGetLatestValues(dcgm.FE_GPU, uint(0), gomock.Any()).DoAndReturn(
+		func(_ dcgm.Field_Entity_Group, _ uint, wanted []dcgm.Short) ([]dcgm.FieldValue_v1, error) {
+			var result []dcgm.FieldValue_v1
+			for _, field := range wanted {
+				if field == power.FieldID {
+					result = append(result, int64FieldValue(field, byte(100+powerReads.Add(1))))
+				}
+				if field == profile.FieldID {
+					status := dcgm.DCGM_ST_OK
+					if broken.Load() == 1 {
+						status = dcgm.DCGM_ST_NOT_WATCHED
+					}
+					result = append(result, profilingFieldValue(field, status, time.Now().UnixMicro(), 1))
+				}
+			}
+			return result, nil
+		},
+	).AnyTimes()
+	// Keep the old implementation runnable so the regression fails on blocking,
+	// rather than on an unexpected mock call.
+	client.EXPECT().UpdateAllFields().Return(nil).AnyTimes()
+	c, err := NewDCGMCollector([]counters.Counter{power, profile}, "host-a", &appconfig.Config{}, watch)
+	require.NoError(t, err)
+	defer c.Cleanup()
+	defer unblock()
+	initial, err := c.GetMetrics()
+	require.NoError(t, err)
+	require.Len(t, initial[profile], 1)
+	broken.Store(1)
+	type result struct {
+		metrics MetricsByCounter
+		err     error
+	}
+	response := make(chan result, 1)
+	go func() { m, e := c.GetMetrics(); response <- result{m, e} }()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("repair did not start")
+	}
+	select {
+	case got := <-response:
+		require.NoError(t, got.err)
+		require.Len(t, got.metrics[power], 1)
+		assert.Equal(t, "102", got.metrics[power][0].Value)
+		assert.Empty(t, got.metrics[profile], "unhealthy profiling must be absent, not zero")
+	case <-time.After(time.Second):
+		unblock()
+		<-response
+		t.Fatal("profiling repair blocked a healthy power scrape")
+	}
+	got, err := c.GetMetrics()
+	require.NoError(t, err)
+	require.Len(t, got[power], 1)
+	assert.Equal(t, "103", got[power][0].Value, "power must not be a cached fallback")
+	assert.Empty(t, got[profile])
+	assert.Zero(t, powerCleanup.Load(), "profiling repair must not unwatch power")
+	unblock()
+	require.Eventually(t, func() bool { m, e := c.GetMetrics(); return e == nil && len(m[profile]) == 1 }, time.Second, time.Millisecond)
+	c.Cleanup()
+	assert.EqualValues(t, 1, powerCleanup.Load())
+}
