+package server
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	stdos "os"
+	"path/filepath"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/NVIDIA/go-dcgm/pkg/dcgm"
+	"github.com/stretchr/testify/require"
+
+	"github.com/NVIDIA/dcgm-exporter/internal/pkg/appconfig"
+	"github.com/NVIDIA/dcgm-exporter/internal/pkg/collector"
+	"github.com/NVIDIA/dcgm-exporter/internal/pkg/counters"
+	"github.com/NVIDIA/dcgm-exporter/internal/pkg/dcgmprovider"
+	"github.com/NVIDIA/dcgm-exporter/internal/pkg/deviceinfo"
+	"github.com/NVIDIA/dcgm-exporter/internal/pkg/devicewatcher"
+	"github.com/NVIDIA/dcgm-exporter/internal/pkg/devicewatchlistmanager"
+	"github.com/NVIDIA/dcgm-exporter/internal/pkg/registry"
+)
+
+// This opt-in hardware probe uses real DCGM, watches, registry and HTTP rendering.
+// Only the profiling status and a five-second repair delay are injected. The
+// external SRT consumer records samples and checks that DCGM power timestamps
+// advance throughout the fault. No injection path enters the production binary.
+func TestLiveProfilingIsolation(t *testing.T) {
+	dir := stdos.Getenv("POWERX_LIVE_PROBE_DIR")
+	if dir == "" {
+		t.Skip("requires an explicitly owned GPU allocation and external SRT consumer")
+	}
+	require.NoError(t, stdos.MkdirAll(dir, 0o755))
+	file, err := stdos.Create(filepath.Join(dir, "dcgm-reads.jsonl"))
+	require.NoError(t, err)
+	defer file.Close()
+	trace := &isolationTrace{encoder: json.NewEncoder(file)}
+	config := &appconfig.Config{CollectInterval: 100, GPUDeviceOptions: appconfig.DeviceOptions{Flex: true, MajorRange: []int{-1}, MinorRange: []int{-1}}}
+	dcgmprovider.Initialize(config)
+	realClient := dcgmprovider.Client()
+	defer realClient.Cleanup()
+	config.MetricGroups, err = realClient.GetSupportedMetricGroups(0)
+	require.NoError(t, err)
+	config.CollectDCP = true
+	client := &isolationClient{DCGM: realClient, trace: trace}
+	dcgmprovider.SetClient(client)
+	defer dcgmprovider.SetClient(realClient)
+	set, err := counters.ExtractCounters([][]string{
+		{"DCGM_FI_DEV_POWER_USAGE", "gauge", "Power in watts"},
+		{"DCGM_FI_DEV_GPU_UTIL", "gauge", "GPU utilization"},
+		{"DCGM_FI_PROF_SM_ACTIVE", "gauge", "SM activity"},
+	}, config)
+	require.NoError(t, err)
+	require.True(t, set.HasProfilingMetrics(), "a power-only run cannot validate profiling isolation")
+	manager := devicewatchlistmanager.NewWatchListManager(set.DCGMCounters, config)
+	watcher := &isolationWatcher{Watcher: devicewatcher.NewDeviceWatcher(), trace: trace}
+	require.NoError(t, manager.CreateEntityWatchList(dcgm.FE_GPU, watcher, 100))
+	r := registry.NewRegistry()
+	defer r.Cleanup()
+	factory := collector.InitCollectorFactory(set, manager, "power-probe", config)
+	for _, tuple := range factory.NewCollectors() {
+		r.Register(tuple)
+	}
+	s, cleanup, err := NewMetricsServer(config, manager, r)
+	require.NoError(t, err)
+	defer cleanup()
+	mux := http.NewServeMux()
+	mux.HandleFunc("/metrics", s.Metrics)
+	mux.HandleFunc("/inject", func(w http.ResponseWriter, request *http.Request) {
+		if request.Method != http.MethodPost {
+			w.WriteHeader(http.StatusMethodNotAllowed)
+			return
+		}
+		if !trace.phase.CompareAndSwap(0, 1) {
+			w.WriteHeader(http.StatusConflict)
+			return
+		}
+		trace.write(map[string]any{"event": "fault_requested", "at": time.Now().UnixMicro()})
+		w.WriteHeader(http.StatusAccepted)
+	})
+	endpoint := httptest.NewServer(mux)
+	defer endpoint.Close()
+	require.NoError(t, stdos.WriteFile(filepath.Join(dir, "endpoint.txt"), []byte(endpoint.URL), 0o644))
+	deadline := time.After(90 * time.Second)
+	ticker := time.NewTicker(100 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-deadline:
+			t.Fatal("external SRT consumer did not finish within 90s")
+		case <-ticker.C:
+			if _, err := stdos.Stat(filepath.Join(dir, "stop")); err == nil {
+				require.EqualValues(t, 3, trace.phase.Load(), "profiling fault and repair must both execute")
+				return
+			}
+		}
+	}
+}
+
+type isolationTrace struct {
+	phase   atomic.Int32
+	mu      sync.Mutex
+	encoder *json.Encoder
+}
+
+func (p *isolationTrace) write(record any) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if err := p.encoder.Encode(record); err != nil {
+		panic(err)
+	}
+}
+
+type isolationClient struct {
+	dcgmprovider.DCGM
+	trace *isolationTrace
+}
+
+func (p *isolationClient) EntityGetLatestValues(group dcgm.Field_Entity_Group, id uint, fields []dcgm.Short) ([]dcgm.FieldValue_v1, error) {
+	start := time.Now()
+	values, err := p.DCGM.EntityGetLatestValues(group, id, fields)
+	for i := range values {
+		v := &values[i]
+		if v.FieldID == dcgm.DCGM_FI_DEV_POWER_USAGE {
+			p.trace.write(map[string]any{"event": "power_read", "at": time.Now().UnixMicro(), "dcgm_timestamp": v.TS, "status": v.Status, "gpu": id, "phase": p.trace.phase.Load(), "request_seconds": time.Since(start).Seconds()})
+		}
+		if v.FieldID == dcgm.DCGM_FI_PROF_SM_ACTIVE && p.trace.phase.Load() == 1 {
+			v.Status = dcgm.DCGM_ST_NOT_WATCHED
+		}
+	}
+	return values, err
+}
+
+type isolationWatcher struct {
+	devicewatcher.Watcher
+	trace *isolationTrace
+}
+
+func (p *isolationWatcher) WatchDeviceFieldGroups(groups []devicewatcher.FieldWatchGroup, info deviceinfo.Provider) ([]dcgm.GroupHandle, []dcgm.FieldHandle, []func(), error) {
+	fault := p.trace.phase.CompareAndSwap(1, 2)
+	if fault {
+		p.trace.write(map[string]any{"event": "repair_entered", "at": time.Now().UnixMicro()})
+		time.Sleep(5 * time.Second)
+	}
+	a, b, cleanups, err := p.Watcher.WatchDeviceFieldGroups(groups, info)
+	if fault {
+		p.trace.phase.Store(3)
+		p.trace.write(map[string]any{"event": "repair_returned", "at": time.Now().UnixMicro(), "success": err == nil})
+	}
+	return a, b, cleanups, err
+}
